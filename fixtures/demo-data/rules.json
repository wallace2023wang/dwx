  {
    "id": "example-risk-review",
    "draft": {
      "name": "高风险客户人工复核",
      "description": "逾期且信用评分低于阈值时转人工审核。",
      "category": "credit_risk",
      "priority": 80,
      "conditions": [
        {
          "field": "overdue",
          "operator": "==",
          "value": "true"
        },
        {
          "field": "creditScore",
          "operator": "<",
          "value": "600"
        }
      ],
      "actions": [
        {
          "field": "riskLevel",
          "value": "高"
        },
        {
          "field": "reviewRequired",
          "value": "true"
        }
      ]
