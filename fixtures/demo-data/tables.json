        "drl": "package workbench\n\n// 与业务系统交换的事实类型；输入字段由调用方设置，动作写回输出字段。\ndeclare RuleInput\n    customerAge : Integer\n    annualIncome : Double\n    creditScore : Integer\n    customerType : String\n    overdue : Boolean\n    riskLevel : String\n    reviewRequired : Boolean\n    approvedLimit : Double\nend\n\nrule \"信用评级决策表（演示） 第1行 [1]\"\n    salience 3\n    no-loop true\nwhen\n    $input : RuleInput( creditScore >= 700, customerType in (\"企业\", \"同业\") )\nthen\n    modify($input) {\n        setRiskLevel(\"低\"),\n        setReviewRequired(false)\n    }\nend\n\nrule \"信用评级决策表（演示） 第2行 [2]\"\n    salience 2\n    no-loop true\nwhen\n    $input : RuleInput( creditScore >= 501, creditScore <= 699, customerType == \"个人\" )\nthen\n    modify($input) {\n        setRiskLevel(\"中\"),\n        setReviewRequired(true)\n    }\nend\n\nrule \"信用评级决策表（演示） 第3行 [3]\"\n    salience 1\n    no-loop true\nwhen\n    $input : RuleInput( creditScore <= 500 )\nthen\n    modify($input) {\n        setRiskLevel(\"高\"),\n        setReviewRequired(true)\n    }\nend\n\nrule \"信用评级决策表（演示） 默认行 [4]\"\n    salience -1\n    no-loop true\nwhen\n    not RuleInput( creditScore >= 700, customerType in (\"企业\", \"同业\") )\n    not RuleInput( creditScore >= 501, creditScore <= 699, customerType == \"个人\" )\n    not RuleInput( creditScore <= 500 )\n    $input : RuleInput(  )\nthen\n    modify($input) {\n        setRiskLevel(\"中\"),\n        setReviewRequired(false)\n    }\nend\n",
        "engineVersion": "10.2.0"
      }
    ],
