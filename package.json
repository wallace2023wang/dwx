{
  "name": "rules-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "npm --prefix frontend run dev",
    "dev:legacy": "vite --config archive/legacy-prototype/vite.config.js --host 127.0.0.1",
    "api": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:import-json": "node server/import-json.js",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "node --test",
    "seed": "node scripts/seed-demo-data.mjs",
    "seed:force": "node scripts/seed-demo-data.mjs --force"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "vite": "^6.1.0"
  }
}
