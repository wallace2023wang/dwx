DATABASE_URL=postgresql://rules:rules-local@127.0.0.1:54329/rules
DB_POOL_SIZE=10
API_PORT=8787
ENGINE_URL=http://127.0.0.1:8788
RES_URL=http://127.0.0.1:8790
RES_MANAGEMENT_URL=http://127.0.0.1:8793
RES_MANAGEMENT_API_KEY=replace-with-management-secret
RES_EXECUTION_API_KEY=replace-with-execution-secret
# Additional local RES instances use the same Team Server credentials but keep
# separate ports and data volumes: test 8800/8803, production 8810/8813.
# New dual-engine names; ENGINE_URL/RES_URL remain rules-compatible aliases.
RULES_BUILD_URL=http://127.0.0.1:8788
RULES_RES_URL=http://127.0.0.1:8790
RULES_RES_MANAGEMENT_URL=http://127.0.0.1:8793
# RULES_RES_MANAGEMENT_API_KEY and RULES_RES_EXECUTION_API_KEY override the shared aliases above.
CEP_BUILD_URL=http://127.0.0.1:8791
CEP_RES_URL=http://127.0.0.1:8792
AUTH_MODE=local
